# Local development only. Use a unique password and HTTPS in production.
POSTGRES_USER=fenix
POSTGRES_PASSWORD=fenix
POSTGRES_DB=fenix
DATABASE_URL=postgresql+psycopg://fenix:fenix@127.0.0.1:5432/fenix?connect_timeout=5
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
ENABLE_DOCS=true
TEMP_PASSWORD_EXPIRATION_HOURS=24
SESSION_HOURS=12
REMEMBER_SESSION_DAYS=30
IDLE_TIMEOUT_MINUTES=60
LOGIN_LIMIT=20
LOCKOUT_MINUTES=15
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=private_uploads
